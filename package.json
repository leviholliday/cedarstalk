{
  "name": "cedarengine",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "build": "bun build --compile --outfile dist/cedarengine --production ./src/index.ts",
    "engine": "bun run src/cli.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "check": "biome check --write .",
    "ci": "biome ci . && tsc --noEmit && bun test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.8",
    "@types/bun": "^1.3.14",
    "playwright-core": "^1.63.0",
    "typescript": "^5.9.3"
  }
}
