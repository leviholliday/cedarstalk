[Unit]
Description=one api over the cedarville directory, catalog and campus
DefaultDependencies=no
After=network-online.target

[Service]
Type=exec
WorkingDirectory=/home/kierank/cedarengine
ExecStart=dist/cedarengine
EnvironmentFile=/home/kierank/cedarengine/.env
TimeoutStartSec=0
Restart=on-failure
RestartSec=5s
StartLimitIntervalSec=60
StartLimitBurst=10

[Install]
WantedBy=default.target
