# Required. Every route except /health demands this as `Authorization: Bearer <token>`.
# Generate one: openssl rand -hex 32
BEARER_TOKEN=

# Optional.
DATABASE_PATH=data/cedarengine.db
PORT=3000
HOST=127.0.0.1  # keep it on loopback unless you mean it

# Optional, and only relevant if you got BEARER_TOKEN from
# https://cedarengine-access.netlify.app rather than generating it yourself.
# Makes this instance check in once at startup so the registry can show
# whether your token is still valid. Leave blank if you generated your own
# token -- nothing here will run without this set.
ACCESS_REGISTRY_URL=
