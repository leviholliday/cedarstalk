# Required, and it has to be one issued at https://cedarstalk.netlify.app --
# every instance validates its token there before it will start at all, the maintainer's own
# included. Generating your own random string here will not work.
BEARER_TOKEN=

# Optional.
DATABASE_PATH=data/cedarengine.db
PORT=3000
HOST=127.0.0.1  # keep it on loopback unless you mean it
